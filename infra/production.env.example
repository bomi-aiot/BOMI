# Copy this file to /home/ubuntu/bomi/secrets/production.env on the EC2 server.
# Never commit the real production.env file.
POSTGRES_DB=bomi
POSTGRES_USER=bomi
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DATA_DIR=/home/ubuntu/bomi/data/postgres

# 의미 검색 벡터 스토어 (S15P11E102-218).
#
# QDRANT_DATA_DIR 은 없습니다. 저장소 위치를 묻지 않습니다.
#
#   전에는 이 자리에 호스트 경로를 받는 변수가 있었습니다. 그 값에 Qdrant Cloud URL 을
#   넣은 채로 배포가 돌아 "undefined volume https" 로 실패했고, 오류 메시지에 변수
#   이름조차 나오지 않았습니다.
#
#   값을 검증하는 대신 물어보지 않는 쪽을 골랐습니다. 이 볼륨은 파생 인덱스이고
#   백업 대상이 아니며, 잃어도 memory/conversation_summary 의 embedding_status
#   부기 컬럼(V5)으로 전량 재색인됩니다. 사람이 그 위치를 알아야 할 이유가 없으니
#   compose 의 named volume(bomi-qdrant-storage)에 맡깁니다.
#
#   오히려 백업해 두면 낡은 payload 가 되살아나 공개범위가 바뀐 기억을 노출할 수
#   있습니다. 위치를 모르는 것이 이 볼륨에는 장점입니다.
#
# 'Qdrant 서버가 어디에 있는가'도 묻지 않습니다 — compose 가 QDRANT_HOST=qdrant 로
# 고정해 넘깁니다(같은 도커 네트워크의 컨테이너 이름).

# 비워 두면 인증 없이 뜹니다. backend-net 이 internal 이라 외부에서 닿지 않지만,
# 네트워크 격리 하나에만 기대지 않습니다 — 나중에 누가 컨테이너를 다른 네트워크에
# 붙이는 순간 격리가 사라지고, 그때 남는 방어선이 이 키뿐입니다.
QDRANT_API_KEY=replace-with-a-long-random-token

# 임베딩 모델 API 키 (Upstage).
#
# 비어 있으면 임베딩을 만들 수 없고 의미 검색이 꺼진 채로 뜹니다. 서비스는 계속
# 동작합니다(키워드·중요도·최근성 랭킹). 다만 조용히 꺼지지 않고 기동 로그에 남고,
# /context 응답의 availability 가 false 로 나갑니다 — 로봇이 '기억을 다 뒤졌다'고
# 착각하면 과거에 대해 실제보다 확신 있게 말합니다.
UPSTAGE_API_KEY=replace-with-upstage-api-key

# ★ 키만 넣으면 켜지지 않습니다. 이 값도 true 로 바꿔야 합니다.
#
# 왜 스위치가 따로 있는가
#   임베딩은 백엔드에서 유일하게 과금되는 외부 API 이고, 잔액이 프로토타입 시연까지
#   감당해야 합니다. 키가 우연히 환경에 들어와 있다고 해서 돈을 쓰기 시작하면 안 됩니다.
EMBEDDING_ENABLED=false

# 배경 재색인 잡. EMBEDDING_ENABLED 와 별개로 켭니다.
#
# 시연 중에는 false 로 두십시오. 질의 임베딩(발화 1건당 1회)만 돌고, 백로그를 훑는
# 배치가 동시에 돌지 않습니다.
#
# ★★ 전제 (S15P11E102-308) — false 로 시연에 들어가도 되는 것은 딱 한 번, sync 를
#    켠 채로 기동해서 기존 memory/conversation_summary 백로그의 초기 색인을 끝낸
#    뒤뿐입니다. 컬렉션(memory, conversation_summary) 자체는 QDRANT_HOST 가 설정돼
#    있으면 이 스위치와 무관하게 기동 시 자동으로 생깁니다(VectorStoreStartupInitializer,
#    S15P11E102-308). 하지만 "컬렉션이 있다"와 "그 안에 벡터가 들어 있다"는 다른
#    얘기입니다 — 기존에 쌓인 기억·요약을 실제로 벡터로 채우는 것은 이 sync 잡의
#    역할이라서, 한 번도 켜지 않고 배포하면 검색은 계속 빈 컬렉션을 상대로 돌고
#    아무것도 찾지 못합니다(예외는 안 남고 결과만 늘 비어 있습니다).
#
#    색인 소요 시간 ≈ ⌈밀린 행 수 / EMBEDDING_SYNC_BATCH_SIZE(=30)⌉ × 5분
#    (sync-interval-millis 기본값 300000ms = 5분. 첫 실행도 기동 직후가 아니라
#    이 5분 뒤에 시작합니다 — initialDelay 를 interval 과 같은 값으로 씁니다.)
#    예: 밀린 행 200건 → ⌈200/30⌉ = 7회 × 5분 ≈ 35분.
#
#    순서: sync 를 true 로 기동 → 위 시간만큼 기다려 백로그가 SYNCED 로 바뀌는지
#    로그(embedding sync: N memories, M summaries indexed...)로 확인 → 그제서야
#    false 로 내리고 재기동. 이 순서를 건너뛰면 "검색이 켜져 있는데 아무것도 안
#    나온다"는 증상만 남고 원인은 로그를 뒤져야 보입니다.
EMBEDDING_SYNC_ENABLED=false

# 한 실행에 과금되는 호출 수의 상한. 튜닝 값이 아니라 지출 상한입니다.
EMBEDDING_SYNC_BATCH_SIZE=30

# AI 대화 MQTT 생명주기 제한. 시작 확인은 10초, 전체 대화는 5분이 기본값이다.
AI_CONVERSATION_START_TIMEOUT=10s
AI_CONVERSATION_MAX_DURATION=5m
AI_CONVERSATION_TIMEOUT_CHECK_INTERVAL_MILLIS=1000

# 대화 요약 생성형 LLM API 키 (Gemini, GMS 경유, S15P11E102-254).
#
# 비어 있으면 대화 요약이 생성되지 않습니다. 서비스는 계속 동작합니다 — 대화는
# 정상적으로 닫히고, 다음 스윕이 조용히 재시도합니다. 다만 로봇이 "지난 대화"를
# 참고할 재료가 계속 비어 있습니다(기동 로그의 "llm generation OFF" 로 확인 가능).
GEMINI_API_KEY=replace-with-gemini-api-key

# ★ 키만 넣으면 켜지지 않습니다. UPSTAGE_API_KEY/EMBEDDING_ENABLED 와 똑같은 이유로
#   스위치가 따로 있습니다 — 백엔드의 두 번째(현재 마지막) 과금 외부 API 이고,
#   잔액이 프로토타입 시연까지 감당해야 합니다.
LLM_ENABLED=false

# 한 번의 요약 스윕이 부를 수 있는 호출 수 상한. 튜닝 값이 아니라 지출 상한입니다.
LLM_MAX_CALLS_PER_RUN=20

# 로봇 채널 공유 비밀키 (S15P11E102-307).
#
# 로봇(ai_chat)이 /api/v1/robot/**, /api/v1/seniors/** 를 호출할 때
# X-Robot-Shared-Secret 헤더로 이 값을 보내야 한다. 비어 있으면 인증 필터가
# 아무것도 막지 않는다 — 값을 실제로 채우는 것은 이 티켓의 범위 밖이며, 로봇
# 쪽 구현(별도 브랜치 S15P11E102-307-ai-로봇채널인증)과 같은 값을 써야 한다.
ROBOT_SHARED_SECRET=

# Use a Git commit SHA or release identifier in deployed environments.
BACKEND_IMAGE_TAG=local
FRONTEND_IMAGE_TAG=local

BOMI_DOMAIN=i15e102.p.ssafy.io
LETSENCRYPT_EMAIL=replace-with-team-email@example.com
CERTBOT_CONF_DIR=/home/ubuntu/bomi/data/certbot/conf
CERTBOT_WEBROOT_DIR=/home/ubuntu/bomi/data/certbot/www

JENKINS_HOME_DIR=/home/ubuntu/bomi/data/jenkins
# Run `stat -c '%g' /var/run/docker.sock` on the EC2 server.
DOCKER_GID=replace-with-docker-socket-group-id

# 가디언웹 채널 단기 접근 제어 (S15P11E102-310).
#
# /api/v1/guardian, /memories, /care-records, /confirmation-requests, /elders 는
# 어르신의 기억·돌봄기록·복약 스케줄을 반환하거나 수정한다. 브라우저 SPA 라
# 로봇 채널(307)처럼 공유 비밀을 넣을 수 없어, 세션·로그인이 붙기 전까지는
# nginx auth_basic 으로 막는다. 진짜 인증(세션/로그인)은 이 티켓 범위 밖이다.
#
# 이 변수는 htpasswd "파일의 경로"만 가리킨다. 파일 자체(해시된 자격 증명)는
# 절대 이 저장소나 production.env 에 값으로 넣지 않는다 — EC2 에서 직접 생성한다.
#
#   sudo install -d -o ubuntu -g ubuntu -m 700 /home/ubuntu/bomi/secrets
#   docker run --rm httpd:2.4-alpine htpasswd -Bbn <guardian용 아이디> '<guardian용 비밀번호>' \
#     > /home/ubuntu/bomi/secrets/guardian.htpasswd
#   chmod 600 /home/ubuntu/bomi/secrets/guardian.htpasswd
#
# 이 값이 비어 있으면 compose 가 nginx 를 아예 기동하지 않는다(다른 필수 경로
# 변수들과 같은 ${VAR:?...} 문법) — 무인증으로 열린 채 조용히 뜨는 것보다
# 배포가 막히는 편이 안전하다는 판단이다.
NGINX_GUARDIAN_HTPASSWD_FILE=/home/ubuntu/bomi/secrets/guardian.htpasswd
