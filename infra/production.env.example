# Copy this file to /home/ubuntu/bomi/secrets/production.env on the EC2 server.
# Never commit the real production.env file.
POSTGRES_DB=bomi
POSTGRES_USER=bomi
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DATA_DIR=/home/ubuntu/bomi/data/postgres

# Use a Git commit SHA or release identifier in deployed environments.
BACKEND_IMAGE_TAG=local
FRONTEND_IMAGE_TAG=local

BOMI_DOMAIN=i15e102.p.ssafy.io
LETSENCRYPT_EMAIL=replace-with-team-email@example.com
CERTBOT_CONF_DIR=/home/ubuntu/bomi/data/certbot/conf
CERTBOT_WEBROOT_DIR=/home/ubuntu/bomi/data/certbot/www

JENKINS_HOME_DIR=/home/ubuntu/bomi/data/jenkins
# Run `stat -c '%g' /var/run/docker.sock` on the EC2 server.
DOCKER_GID=replace-with-docker-socket-group-id
