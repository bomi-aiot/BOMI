# Copy this file to /home/ubuntu/bomi/secrets/production.env on the EC2 server.
# Never commit the real production.env file.
POSTGRES_DB=bomi
POSTGRES_USER=bomi
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DATA_DIR=/home/ubuntu/bomi/data/postgres

# Use a Git commit SHA or release identifier in deployed environments.
BACKEND_IMAGE_TAG=local
