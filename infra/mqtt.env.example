# Copy this file to /home/ubuntu/bomi/secrets/mqtt.env on the EC2 server.
# Never commit the real mqtt.env or password file.
MQTT_PASSWORD_FILE=/home/ubuntu/bomi/secrets/mosquitto/passwords
MQTT_DATA_DIR=/home/ubuntu/bomi/data/mosquitto/data
MQTT_LOG_DIR=/home/ubuntu/bomi/data/mosquitto/log
MQTT_CERT_DIR=/home/ubuntu/bomi/secrets/mosquitto/certs
MQTT_HEALTH_USERNAME=bomi-healthcheck
MQTT_HEALTH_PASSWORD=replace-with-a-long-random-password

BOMI_DOMAIN=i15e102.p.ssafy.io
CERTBOT_CONF_DIR=/home/ubuntu/bomi/data/certbot/conf
