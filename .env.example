POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bomi
POSTGRES_USER=bomi
POSTGRES_PASSWORD=change-me

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_ENABLED=false
MQTT_CLIENT_ID_PREFIX=bomi-backend
MQTT_USERNAME=change-me
MQTT_PASSWORD=change-me

BACKEND_PORT=8080
FRONTEND_PORT=5173

# 의미 검색 (S15P11E102-218/308). 넷 다 기본 꺼짐 — 과금 API 라 명시적으로 켠다.
EMBEDDING_ENABLED=false
# 배경 재색인 잡. 최초 1회는 켜서 컬렉션을 채운 뒤 꺼야 한다 (infra/production.env.example 참고).
EMBEDDING_SYNC_ENABLED=false
# 비우면 의미 검색이 꺼진 채로 뜬다. docker-compose 의 qdrant 서비스를 쓰면 보통 localhost.
QDRANT_HOST=
# 비우면 EMBEDDING_ENABLED=true 여도 임베딩을 만들 수 없다.
UPSTAGE_API_KEY=

# 대화 요약 생성형 LLM — Gemini, GMS 경유 (S15P11E102-254). 기본 꺼짐 — 과금 API.
LLM_ENABLED=false
# 비우면 LLM_ENABLED=true 여도 요약을 생성할 수 없다.
GEMINI_API_KEY=

