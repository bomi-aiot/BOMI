<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bridge</name>
  <version>0.0.0</version>
  <description>백엔드 MQTT와 로봇 내부 ROS 2 토픽을 잇는 통역 브릿지 패키지</description>
  <maintainer email="wdg0434@naver.com">wdg</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!-- Nav2 주행 드라이버가 직접 사용하는 의존성 -->
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>ament_index_python</depend>

  <!-- 목적지 좌표 로더(waypoint_route)와 room_waypoints.yaml 재사용 -->
  <depend>core</depend>

  <!-- ROS 2 launch 실행에 필요한 의존성 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>twist_mux</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
