<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="bomi_robot">

    <link name="base_link">
      <pose>0 0 0.18 0 0 0</pose>

      <!--
        관성은 0.45 x 0.32 x 0.12 m 직육면체(5.0 kg)의 이론값이다.
        배터리와 구동부가 차체 아래쪽에 실린다고 보고 무게중심을
        링크 원점보다 0.04 m 낮춰 주행 중 전복 여유를 확보한다.
      -->
      <inertial>
        <pose>0 0 -0.04 0 0 0</pose>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.048667</ixx>
          <iyy>0.090375</iyy>
          <izz>0.127042</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.45 0.32 0.12</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.45 0.32 0.12</size>
          </box>
        </geometry>

        <material>
          <ambient>0.2 0.5 0.8 1</ambient>
          <diffuse>0.2 0.5 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.19 0.10 1.5708 0 0</pose>

      <!-- 반지름 0.10 m, 두께 0.04 m 원통(0.5 kg)의 이론 관성. 로컬 z가 회전축이다. -->
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001317</ixx>
          <iyy>0.001317</iyy>
          <izz>0.002500</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>

        <!-- 구동륜은 미끄러지지 않도록 마찰을 명시한다. -->
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.19 0.10 1.5708 0 0</pose>

      <!-- 반지름 0.10 m, 두께 0.04 m 원통(0.5 kg)의 이론 관성. 로컬 z가 회전축이다. -->
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001317</ixx>
          <iyy>0.001317</iyy>
          <izz>0.002500</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>

        <!-- 구동륜은 미끄러지지 않도록 마찰을 명시한다. -->
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <!--
      캐스터는 앞뒤 두 곳에 둔다. 뒤쪽에만 있으면 지지 다각형의 앞 경계가
      구동륜 축과 같아져 전진 가감속만으로도 로봇이 앞으로 넘어지고,
      기울어진 LiDAR가 바닥을 가짜 장애물로 인식한다.
      두 캐스터 모두 접지점이 z = 0으로 구동륜과 같은 높이다.
    -->
    <link name="rear_caster">
      <pose>-0.18 0 0.05 0 0 0</pose>

      <!-- 반지름 0.05 m 구(0.2 kg)의 이론 관성. -->
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>

        <!-- 고정 캐스터가 바닥을 잡아 주행과 제자리 회전을 방해하지 않도록 마찰을 없앤다. -->
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
      </visual>
    </link>

    <link name="front_caster">
      <pose>0.18 0 0.05 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
      </visual>
    </link>

    <link name="lidar_link">
      <pose>0.12 0 0.30 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <collision name="lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.03 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <!--
      바퀴 링크는 X축으로 90도 돌아가 있고 SDF의 axis/xyz 기본 표현 좌표계는
      조인트 프레임(= 자식 링크 프레임)이다. 따라서 <xyz>0 0 1</xyz>은
      모델 좌표계에서 -Y가 되어 DiffDrive가 전진 명령에 후진한다.
      혼동을 없애기 위해 모델 좌표계로 명시한다.
    -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>

      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>

      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>

    <joint name="rear_caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_caster</child>
    </joint>

    <joint name="front_caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_caster</child>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <plugin
      filename="ignition-gazebo-diff-drive-system"
      name="ignition::gazebo::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.38</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

  </model>
</sdf>
