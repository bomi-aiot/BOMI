########################################################################################################################
########################################### AI CHAT 관련 설정 ###########################################################
########################################################################################################################

RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
GEMINI_API_KEY=
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
KMA_API_KEY=



########################################################################################################################
########################################### 오디오 관련 설정 #############################################################
########################################################################################################################

# 오디오 실행 모드: laptop은 OS 기본 장치를 허용하고 robot은 장치 지정이 필수다.
AUDIO_MODE=laptop
# 대상 장치에서 확인한 PortAudio 인덱스(예: 0) 또는 장치명 일부를 입력한다.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SECONDS=0.5
AUDIO_SILENCE_THRESHOLD=300
AUDIO_SILENCE_LIMIT_SECONDS=3
AUDIO_MAX_SECONDS=15

# 웨이크워드('보미야') 로컬 감지 (S15P11E102-222)
#
# 켜져 있으면 로봇은 "보미야"를 들을 때까지 상시 대기하다가, 감지된 뒤에만 대화를
# 시작한다. 끄면 상시 청취가 되어 지나가는 말과 TV 소리에도 응답을 시도한다.
# 노트북 개발에서는 0 으로 두는 편이 편하다 — openWakeWord 모델을 내려받지 않는다.
WAKEWORD_ENABLED=1
# openWakeWord 모델(.onnx) 경로. 실행 디렉터리 기준 상대경로도 된다.
WAKEWORD_MODEL_PATH=models/bomiya.onnx

########################################################################################################################
############################################ 로봇 마이크 관련 설정 ########################################################
########################################################################################################################

# =========================================================
# ReSpeaker XVF3800 고정 빔(fixed beam) 제어 설정
# =========================================================
# 앞쪽 고정 사용 여부. "1"이면 대화 시작 시 빔을 앞쪽으로 고정, 그 외엔 skip.
# (조립 + 앞각 캘리브레이션 전까지는 0으로 두면 기존 캡처 흐름 그대로 동작)
BEAM_FIX_ENABLED=0
# xvf_host 실행 파일 경로. Windows(개발용) 예시:
XVF_HOST_PATH=C:\Users\SSAFY\Desktop\reSpeaker_XVF3800_USB_4MIC_ARRAY\host_control\win32\xvf_host.exe
# 로봇(Jetson) 배포 시 예: /home/ssafy/reSpeaker_XVF3800_USB_4MIC_ARRAY/host_control/jetson/xvf_host
# 제어 프로토콜(usb/i2c/spi). 비우면 장치 기본값(usb).
XVF_HOST_PROTOCOL=
# 앞쪽 방위각(도). 조립 후 `python -m tests.calibrate_beam`으로 실측해서 채운다.
BEAM_FRONT_AZIMUTH_DEG=180
# 비활성 빔 음소거(gating). 보통 0으로 시작.
BEAM_GATING=1
# 간섭 제거기 문턱값(낮출수록 먼 방향 목소리까지 억제). 예: 0.2. 비우면 장치 기본값.
BEAM_NOISE_THRESHOLD=0.4


########################################################################################################################
############################################ 외부 호출 관련 설정 ########################################################
########################################################################################################################

# 외부 HTTP 호출 안정성 기본값
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=0.5
HTTP_MAX_BACKOFF_SECONDS=2

# RTZR 결과 폴링과 인증 토큰 캐시
STT_POLL_INTERVAL_SECONDS=0.5
STT_POLL_TIMEOUT_SECONDS=60
STT_TOKEN_TTL_SECONDS=3000

# 기본값은 현재 운영 방식인 ssh이며, 로컬 DB는 direct로 전환한다.
DB_CONNECTION_MODE=ssh

# EC2 SSH 터널용
EC2_HOST=
EC2_SSH_USER=ubuntu
SSH_KEY_PATH=
REMOTE_DB_HOST=172.18.0.2
REMOTE_DB_PORT=5432

# direct 모드: DATABASE_URL 하나 또는 DB_HOST~DB_PASSWORD를 설정한다.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ssh 모드에서 추가로 필요한 값
EC2_HOST=
EC2_SSH_USER=ec2-user
SSH_KEY_PATH=
REMOTE_DB_HOST=localhost
REMOTE_DB_PORT=5432

# 로봇 로컬 운영 상태(SQLite)가 사는 디렉터리.
#
# 여기에 런타임 DB, 보호자 알림 발신 큐, 캐시 TTS 오디오가 모두 모인다.
# 하나로 모은 이유는 일일 백업이 디렉터리 하나만 복사하면 되고, SD카드를 교체할 때
# 옮길 대상이 명확해지기 때문이다. 실기에서는 절대 경로를 권한다.
LOCALSTORE_DIR=var/localstore

# 백엔드(대화 문맥 조립 API) 주소.
#
# 타임아웃이 짧은 이유: 이 호출은 턴 지연 예산(약 2초) 안에 있다. 오래 기다리느니
# 로컬 캐시로 내려가 얕게라도 대답하는 편이 낫다.
BACKEND_BASE_URL=https://i15e102.p.ssafy.io/
BACKEND_TIMEOUT_SECONDS=1.5

# 백엔드 서블릿 필터(S15P11E102-307)가 검사하는 공유 시크릿.
#
# 네 클라이언트(문맥 조회, 온보딩/재질의, 대화 이벤트, 현관 이벤트)가 모두 이 값을
# X-Robot-Shared-Secret 헤더로 실어 보낸다(backend_client/session.py 한 곳에서만
# 얹는다). 비워 두면 헤더 없이 나가며, 백엔드도 시크릿이 없으면 검사를 건너뛰므로
# 로컬 개발은 계속 동작한다. 실기에서 백엔드에는 시크릿이 걸려 있는데 여기가
# 비어 있으면 401 을 맞고, 그 사실이 캐시 폴백과 구분되는 경고 로그로 남는다.
BACKEND_SHARED_SECRET=

# 이 로봇의 id (robot 테이블의 UUID).
#
# 로봇에서 온보딩 세션을 '새로' 시작할 때 서버가 요구합니다. 앱에서 시작한 세션을
# 이어받을 때는 필요 없습니다. 미설정이면 로봇이 온보딩을 시작하지 못하고, 그 사실을
# 로그로 남깁니다(조용히 넘어가지 않습니다).
ROBOT_ID=

# 이 로봇이 돌보는 어르신 (app_user 의 UUID).
#
# ★ checkpointer 의 thread_id 이자 모든 로컬 저장소의 키입니다. 틀리면 두 어르신이
#   침묵 사다리를 공유하게 되고, 그것은 한 사람의 발화가 다른 사람의 에스컬레이션을
#   억제한다는 뜻입니다.
#
# 기본값이 없습니다. 그래프 경로로 기동하려면 반드시 설정해야 합니다 — 임의의 값으로
# 시작하면 그 값으로 상태가 쌓이고, 나중에 바꾸는 순간 그동안의 기록이 사라집니다.
SENIOR_ID=10000000-0000-4000-8000-000000000001

# 대화 런타임(그래프) 경로로 띄울지 여부.
#
# false 로 두면 200번 이전의 ConversationPipeline 으로 돕니다 — STT → LLM → TTS 만
# 하고 게이트·침묵 사다리·트리아지·현관이 전부 꺼집니다.
#
# 실기에서 새 경로에 문제가 생기면 이 값을 false 로 바꿔 즉시 되돌릴 수 있습니다.
# 되돌리기가 코드 수정이면 현장에서 할 수 없습니다.
USE_GRAPH_RUNTIME=true

# ── 현관 이벤트 MQTT 구독  (CLAUDE.md §11) ────────────────────────────────────
#
# 기본값이 비활성인 이유
#   브로커가 없는 개발 노트북에서는 구독 스레드가 무한 재연결을 시도하며 로그를 덮는다.
#   실기에서는 반드시 켜야 하는 값이므로, 명시적으로 켜는 것이 배포 체크리스트에
#   남는 편이 낫다. 끈 상태에서는 occupancy 가 영원히 UNKNOWN 이고 미귀가·야간 배회를
#   감지하지 못한다(그 사실을 시작 시 경고로 남긴다).
MQTT_ENABLED=false

# 브로커 주소. scheme 이 TLS 여부를 정한다.
#   mqtt://jetson.local:1883        Jetson 로컬, 개발
#   mqtts://<ec2-host>:8883         서버(bomi-mosquitto)
# host/port/tls 를 따로 받지 않는 이유는 세 값이 어긋난 조합(8883 인데 평문)이
# 조용히 연결 실패로 이어지기 때문이다.
MQTT_BROKER_URL=

# 구독 토픽. 규약은 bomi/v1/{domain}/{deviceId}/{channel} 이고, 두 센서
# (SNZB-03P 모션, SNZB-04P 접점)가 각자 다른 deviceId 로 발행하므로 와일드카드를 쓴다.
MQTT_DOOR_TOPIC=bomi/v1/iot/+/events

MQTT_CLIENT_ID=bomi-robot-ai-chat
MQTT_USERNAME=
MQTT_PASSWORD=

# 기본값은 실행 디렉터리의 .env 파일이다.
AI_CHAT_ENV_FILE=.env
