########################################################################################################################
########################################### AI CHAT 관련 설정 ###########################################################
########################################################################################################################

RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
GEMINI_API_KEY=
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
KMA_API_KEY=



########################################################################################################################
########################################### 오디오 관련 설정 #############################################################
########################################################################################################################

# 오디오 실행 모드: laptop은 OS 기본 장치를 허용하고 robot은 장치 지정이 필수다.
AUDIO_MODE=laptop
# 대상 장치에서 확인한 PortAudio 인덱스(예: 0) 또는 장치명 일부를 입력한다.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SECONDS=0.5
AUDIO_SILENCE_THRESHOLD=150
AUDIO_SILENCE_LIMIT_SECONDS=3
AUDIO_MAX_SECONDS=15

# 웨이크워드('보미야') 로컬 감지 (S15P11E102-222)
#
# 켜져 있으면 로봇은 "보미야"를 들을 때까지 상시 대기하다가, 감지된 뒤에만 대화를
# 시작한다. 끄면 상시 청취가 되어 지나가는 말과 TV 소리에도 응답을 시도한다.
# 노트북 개발에서는 0 으로 두는 편이 편하다 — openWakeWord 모델을 내려받지 않는다.
WAKEWORD_ENABLED=1
# openWakeWord 모델(.onnx) 경로. 실행 디렉터리 기준 상대경로도 된다.
WAKEWORD_MODEL_PATH=models/bomiya.onnx

########################################################################################################################
############################################ 로봇 마이크 관련 설정 ########################################################
########################################################################################################################

# =========================================================
# ReSpeaker XVF3800 고정 빔(fixed beam) 제어 설정
# =========================================================
# 앞쪽 고정 사용 여부. "1"이면 대화 시작 시 빔을 앞쪽으로 고정, 그 외엔 skip.
# (조립 + 앞각 캘리브레이션 전까지는 0으로 두면 기존 캡처 흐름 그대로 동작)
BEAM_FIX_ENABLED=0
# xvf_host 실행 파일 경로. Windows(개발용) 예시:
XVF_HOST_PATH=C:\Users\SSAFY\Desktop\reSpeaker_XVF3800_USB_4MIC_ARRAY\host_control\win32\xvf_host.exe
# 로봇(Jetson) 배포 시 예: /home/ssafy/reSpeaker_XVF3800_USB_4MIC_ARRAY/host_control/jetson/xvf_host
# 제어 프로토콜(usb/i2c/spi). 비우면 장치 기본값(usb).
XVF_HOST_PROTOCOL=
# 앞쪽 방위각(도). 조립 후 `python -m tests.calibrate_beam`으로 실측해서 채운다.
BEAM_FRONT_AZIMUTH_DEG=180
# 비활성 빔 음소거(gating). 보통 0으로 시작.
BEAM_GATING=0
# 간섭 제거기 문턱값(낮출수록 먼 방향 목소리까지 억제). 예: 0.2. 비우면 장치 기본값.
BEAM_NOISE_THRESHOLD=0.4


########################################################################################################################
############################################ 외부 호출 관련 설정 ########################################################
########################################################################################################################

# 외부 HTTP 호출 안정성 기본값
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=0.5
HTTP_MAX_BACKOFF_SECONDS=2

# RTZR 결과 폴링과 인증 토큰 캐시
STT_POLL_INTERVAL_SECONDS=0.5
STT_POLL_TIMEOUT_SECONDS=60
STT_TOKEN_TTL_SECONDS=3000

# 기본값은 현재 운영 방식인 ssh이며, 로컬 DB는 direct로 전환한다.
DB_CONNECTION_MODE=ssh

# EC2 SSH 터널용
EC2_HOST=
EC2_SSH_USER=ubuntu
SSH_KEY_PATH=
REMOTE_DB_HOST=172.18.0.2
REMOTE_DB_PORT=5432

# direct 모드: DATABASE_URL 하나 또는 DB_HOST~DB_PASSWORD를 설정한다.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ssh 모드에서 추가로 필요한 값
EC2_HOST=
EC2_SSH_USER=ec2-user
SSH_KEY_PATH=
REMOTE_DB_HOST=localhost
REMOTE_DB_PORT=5432

# 로봇 로컬 운영 상태(SQLite)가 사는 디렉터리.
#
# 여기에 런타임 DB, 보호자 알림 발신 큐, 캐시 TTS 오디오가 모두 모인다.
# 하나로 모은 이유는 일일 백업이 디렉터리 하나만 복사하면 되고, SD카드를 교체할 때
# 옮길 대상이 명확해지기 때문이다. 실기에서는 절대 경로를 권한다.
LOCALSTORE_DIR=var/localstore

# 백엔드(대화 문맥 조립 API) 주소.
#
# 타임아웃이 짧은 이유: 이 호출은 턴 지연 예산(약 2초) 안에 있다. 오래 기다리느니
# 로컬 캐시로 내려가 얕게라도 대답하는 편이 낫다.
BACKEND_BASE_URL=https://i15e102.p.ssafy.io/
BACKEND_TIMEOUT_SECONDS=1.5

# 백엔드 서블릿 필터(S15P11E102-307)가 검사하는 공유 시크릿.
#
# 네 클라이언트(문맥 조회, 온보딩/재질의, 대화 이벤트, 현관 이벤트)가 모두 이 값을
# X-Robot-Shared-Secret 헤더로 실어 보낸다(backend_client/session.py 한 곳에서만
# 얹는다). 비워 두면 헤더 없이 나가며, 백엔드도 시크릿이 없으면 검사를 건너뛰므로
# 로컬 개발은 계속 동작한다. 실기에서 백엔드에는 시크릿이 걸려 있는데 여기가
# 비어 있으면 401 을 맞고, 그 사실이 캐시 폴백과 구분되는 경고 로그로 남는다.
BACKEND_SHARED_SECRET=

# 이 로봇의 id (robot 테이블의 UUID). ★ MQTT 에는 쓰지 않습니다 — 아래 ROBOT_DEVICE_ID 참고.
#
# 로봇에서 온보딩 세션을 '새로' 시작할 때 서버가 요구합니다. 앱에서 시작한 세션을
# 이어받을 때는 필요 없습니다. 미설정이면 로봇이 온보딩을 시작하지 못하고, 그 사실을
# 로그로 남깁니다(조용히 넘어가지 않습니다).
ROBOT_ID=

# 이 로봇의 MQTT deviceId (robot 테이블의 device_id, 시드 기본값: bomi-AA001).
#
# MQTT 토픽의 {robotId} 와 봉투의 robotId 는 UUID 가 아니라 '이 값'입니다. 백엔드가
# device_id 로 로봇을 조회하므로, UUID 를 넣으면 UNKNOWN_ROBOT 으로 '조용히' 차단되어
# 시나리오가 한 번도 돌지 않습니다 (에러 응답 없음 — 서버 로그에만 남습니다).
# 웨이크워드 발행·백엔드 명령 구독이 전부 이 값을 씁니다. 미설정이면 해당 기능이
# 꺼지고 그 사실을 경고로 남깁니다.
ROBOT_DEVICE_ID=

# 이 로봇이 돌보는 어르신 (app_user 의 UUID).
#
# ★ checkpointer 의 thread_id 이자 모든 로컬 저장소의 키입니다. 틀리면 두 어르신이
#   침묵 사다리를 공유하게 되고, 그것은 한 사람의 발화가 다른 사람의 에스컬레이션을
#   억제한다는 뜻입니다.
#
# 기본값이 없습니다. 그래프 경로로 기동하려면 반드시 설정해야 합니다 — 임의의 값으로
# 시작하면 그 값으로 상태가 쌓이고, 나중에 바꾸는 순간 그동안의 기록이 사라집니다.
SENIOR_ID=10000000-0000-4000-8000-000000000001

# 대화 런타임(그래프) 경로로 띄울지 여부.
#
# false 로 두면 200번 이전의 ConversationPipeline 으로 돕니다 — STT → LLM → TTS 만
# 하고 게이트·침묵 사다리·트리아지·현관이 전부 꺼집니다.
#
# 실기에서 새 경로에 문제가 생기면 이 값을 false 로 바꿔 즉시 되돌릴 수 있습니다.
# 되돌리기가 코드 수정이면 현장에서 할 수 없습니다.
USE_GRAPH_RUNTIME=true

# T3 동의 질문 기능의 운영 킬스위치 (S15P11E102-253).
#
# policy.T3_CONSENT_ENABLED(코드 상수, 제품 판단)와 별개로, 이 값은 '오늘 당장'
# 끄고 싶을 때 쓰는 운영 비상구입니다. 실기에서 이 질문이 이상하게 나간다는
# 신고가 들어오면, 코드를 고치고 재배포할 시간이 없어도 이 값 하나로 그날 안에
# 끌 수 있어야 합니다. jobs/ticks.consent_tick 이 이 값과 policy 값을 모두
# 확인하고, 둘 중 하나라도 꺼지면 질문을 올리지 않습니다.
T3_CONSENT_ENABLED=true

# 사실 추출 기능의 운영 킬스위치 (S15P11E102-255).
#
# policy.EXTRACTION_ENABLED(코드 상수, 제품 판단)와 별개로, 이 값은 '오늘 당장'
# 끄고 싶을 때 쓰는 운영 비상구입니다. LLM 비용이 튀거나 잘못된 사실 후보가
# 쏟아진다는 신고가 들어오면, 코드를 고치고 재배포할 시간이 없어도 이 값
# 하나로 그날 안에 끌 수 있어야 합니다. graph/build.py 의 큐잉과
# jobs/ticks.extraction_flush 둘 다 이 값과 policy 값을 모두 확인하고,
# 둘 중 하나라도 꺼지면 아무것도 하지 않습니다.
EXTRACTION_ENABLED=true

# ── 현관 이벤트 MQTT 구독  (CLAUDE.md §11) ────────────────────────────────────
#
# 기본값이 비활성인 이유
#   브로커가 없는 개발 노트북에서는 구독 스레드가 무한 재연결을 시도하며 로그를 덮는다.
#   실기에서는 반드시 켜야 하는 값이므로, 명시적으로 켜는 것이 배포 체크리스트에
#   남는 편이 낫다. 끈 상태에서는 occupancy 가 영원히 UNKNOWN 이고 미귀가·야간 배회를
#   감지하지 못한다(그 사실을 시작 시 경고로 남긴다).
MQTT_ENABLED=false

# 브로커 주소. scheme 이 TLS 여부를 정한다.
#   mqtt://jetson.local:1883        Jetson 로컬, 개발
#   mqtts://<ec2-host>:8883         서버(bomi-mosquitto)
# host/port/tls 를 따로 받지 않는 이유는 세 값이 어긋난 조합(8883 인데 평문)이
# 조용히 연결 실패로 이어지기 때문이다.
MQTT_BROKER_URL=

# 구독 토픽. 규약은 bomi/v1/{domain}/{deviceId}/{channel} 이고, 두 센서
# (SNZB-03P 모션, SNZB-04P 접점)가 각자 다른 deviceId 로 발행하므로 와일드카드를 쓴다.
MQTT_DOOR_TOPIC=bomi/v1/iot/+/events

# 백엔드 대화 명령(START_CONVERSATION) 구독과 웨이크워드 이벤트 발행은 이
# 토픽을 쓰지 않는다 — ROBOT_DEVICE_ID(위)로 bomi/v1/ai/{robotId}/commands
# 와 bomi/v1/robot/{robotId}/events 를 직접 구성한다. 별도 환경변수가 없는
# 이유는 규약이 고정 패턴이라 host/port 처럼 배포마다 바뀌지 않기 때문이다.
# MQTT_ENABLED=false 면 현관 인사·복약 알림·온습도 안부, 세 시나리오의
# 대화가 전혀 시작되지 않는다(그 사실을 시작 시 경고로 남긴다).

MQTT_CLIENT_ID=bomi-robot-ai-chat
MQTT_USERNAME=
MQTT_PASSWORD=

# 이동 중 침묵(CLAUDE.md §3a) — 보미야 호출 뒤 짧은 응답만 하고, 백엔드가
# 유발하는 NAVIGATE(LIVING_ROOM) 의 도착(v1 NAVIGATION_RESULT/ARRIVED)을
# 기다렸다가 본 대화를 연다. 못 받아도 policy.WAKE_MOVEMENT_WAIT_TIMEOUT_SEC
# (45초) 뒤에는 그 자리에서 연다.
#
# 기본값이 꺼짐인 이유
#   로봇/브릿지 없이 노트북에서 대화만 개발할 때 켜져 있으면, 매 "보미야"
#   마다 ARRIVED 를 영원히 못 받고 45초를 그냥 날린 뒤에야 대화가 시작된다.
#   실제 시연/실기 환경(bridge 가 살아서 NAVIGATION_RESULT 를 발행하는 곳)
#   에서만 명시적으로 켠다.
WAKE_MOVEMENT_WAIT_ENABLED=false

# 기본값은 실행 디렉터리의 .env 파일이다.
AI_CHAT_ENV_FILE=.env

# ─────────────────────────────────────────────────────────────────────────────
# 보미야 호출 회전 탐색 신호 (search_signal.py, 구현계획 §0)
#
# "보미야"를 들으면 소리 방향을 로봇 내부(ROS 2 wake_search 노드)로 UDP 로
# 보냅니다. 백엔드 MQTT 계약은 payload 필드가 keyword/confidence 로 못 박혀
# 있어 각도를 실을 수 없기 때문에, "언제 시작할지"(MQTT)와 "어디로 돌지"(UDP)를
# 나눠서 보냅니다.
# ─────────────────────────────────────────────────────────────────────────────

# 신호를 보낼지. 0으로 두면 보미야를 불러도 로봇이 사람을 찾으러 돌지 않습니다.
SEARCH_SIGNAL_ENABLED=1

# ─────────────────────────────────────────────────────────────────────────────
# 현관 이동 환호 (entrance_cheer.py)
#
# 문이 열려 로봇이 현관으로 출발하는 순간 한 마디 외칩니다. 도착해서 인사할
# 때까지의 몇 초가 "마중 나오는 중"으로 읽히게 하려는 것입니다. 백엔드 명령
# 토픽을 엿듣기만 하므로 계약은 건드리지 않습니다.
# ─────────────────────────────────────────────────────────────────────────────

# 환호할지. 0으로 두면 조용히 현관으로 갑니다.
ENTRANCE_CHEER_ENABLED=1

# 외칠 말. "|" 로 나누면 여러 마디를 차례로 말합니다 — 현관까지 15~30초라
# 한 마디로는 나머지가 침묵이 됩니다. 이동 중에는 마이크를 열지 않으므로
# 로봇이 자기 소리를 듣지 않습니다.
ENTRANCE_CHEER_TEXT=야호!|할머니 오셨구나!|지금 마중 나가는 중이에요!|조금만 기다려 주세요!

# 환호 전체의 시간 상한(초). 도착하면 곧바로 귀가 인사가 시작되는데, 그때까지
# 환호가 남아 있으면 두 소리가 겹칩니다. 넘기면 남은 마디를 버립니다.
ENTRANCE_CHEER_MAX_SECONDS=20

# 마디 사이의 숨(초). 0에 가까울수록 붙여 말해 다급하게 들립니다.
ENTRANCE_CHEER_GAP_SEC=0.4

# LCD 가 읽는 상태 파일 경로. 비워 두면 상태를 쓰지 않습니다(LCD 없는 개발
# 환경). 시연에서는 demo-start.sh 가 /tmp/bomi_ai_status 로 넣어 줍니다.
BOMI_DISPLAY_STATUS_FILE=

# 받는 쪽 주소와 포트. wake_search 노드의 hint_bind_host/hint_bind_port 와
# 같아야 합니다(core/config/wake_search.yaml). 같은 젯슨이면 루프백입니다.
SEARCH_SIGNAL_HOST=127.0.0.1
SEARCH_SIGNAL_PORT=5006

# 마이크에서 소리 방향을 읽을지. 0이면 각도 없이 보내고 로봇이 전체 한 바퀴를
# 돕니다(느릴 뿐 시나리오는 성립합니다).
#
# ★ BEAM_FIX_ENABLED=1 이면 빔이 정면에 고정돼 방향 값이 항상 정면으로 나옵니다.
#   그 조합에서는 이 설정이 켜져 있어도 자동으로 전체 탐색으로 넘어갑니다.
# ★ 방향을 쓰려면 조립 후 tests/calibrate_beam.py 로
#   BEAM_FRONT_AZIMUTH_DEG 를 먼저 실측해 넣어야 합니다.
SEARCH_USE_BEAM_DIRECTION=1

# 마이크 각도가 늘어나는 방향. 로봇이 소리와 반대쪽으로 돌면 -1 로 뒤집습니다.
# (ROS 2 규약은 로봇 기준 왼쪽이 양수입니다.)
SEARCH_AZIMUTH_SIGN=1

# 감지 시점에 방향을 한 번 읽으면 이미 말이 끝난 뒤의 무작위 값을 잡습니다
# (2026-08-09 실기: 왼쪽에서 불렀는데 오른쪽으로 돌았습니다). 그래서 계속
# 기록해 두고 '직전 몇 초' — 사람이 실제로 말하던 구간 — 만 씁니다.
#
# 몇 초 분량을 볼지.
SEARCH_AZIMUTH_WINDOW_SEC=3.0
# 얼마 간격으로 읽을지.
SEARCH_AZIMUTH_INTERVAL_SEC=0.15
# 창 안의 표본 중 몇 개가 서로 일치해야 방향을 믿을지. 못 믿으면 각도 없이
# 전체 탐색으로 넘어갑니다(느릴 뿐 확실합니다). "보미야" 한 마디는 짧아
# 표본이 1~2개만 잡히므로 5 는 지나치게 빡빡했습니다.
SEARCH_AZIMUTH_MIN_AGREEMENT=2

# 방향 판별용 고정 빔의 좌·우 방위각(도).
#
# 빔을 좌우로 벌려 두면 마이크가 돌려주는 각도가 이 두 값으로 스냅되어 표본이
# 서로 어긋나지 않습니다(위 MIN_AGREEMENT 가 성립하는 전제입니다).
BEAM_DIRECTION_LEFT_DEG=90
BEAM_DIRECTION_RIGHT_DEG=270
