# DHT11 OUT은 물리 핀 7번(BCM GPIO4)에 고정되어 있다.
# SENSOR_ID는 백엔드 application.yml의 bomi.observation.ambient-sensor-to-senior
# 에 등록된 값과 정확히 같아야 한다. 다르면 이벤트가 도착해도 조용히 폐기된다.
SENSOR_ID=ambient-sensor-01
LOCATION=LIVING_ROOM
READ_INTERVAL_SECONDS=30
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_QOS=1
# MQTT_USERNAME=
# MQTT_PASSWORD=
